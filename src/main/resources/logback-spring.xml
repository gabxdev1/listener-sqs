<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="listener-sqs"/>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>

                <pattern>
                    <pattern>
                        { "service": "${APP_NAME}" }
                    </pattern>
                </pattern>

                <pattern>
                    <pattern>
                        { "message": "#tryJson{%message}" }
                    </pattern>
                </pattern>

                <!-- nível -->
                <logLevel/>      <!-- fieldName padrão: level -->

                <!-- logger -->
                <loggerName/>    <!-- fieldName padrão: logger_name -->

                <!-- thread -->
                <threadName/>    <!-- fieldName padrão: thread_name -->

                <mdc/>

                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>

</configuration>
